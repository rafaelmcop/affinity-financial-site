# Generate a unique random value. If unavailable, sessions temporarily derive
# their signing key from ADMIN_PASSWORD.
JWT_SECRET=

# Administrative login. Never commit the real values.
ADMIN_EMAIL=
# Generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'NEW_PASSWORD'
ADMIN_PASSWORD_HASH=
# Temporary fallback only. Remove after ADMIN_PASSWORD_HASH is confirmed.
ADMIN_PASSWORD=

# Optional local preview account. Never configure these in production.
PREVIEW_ADMIN_EMAIL=
PREVIEW_ADMIN_PASSWORD=

DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@affinityfc.org
